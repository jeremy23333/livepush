# =========================================================
# livepush — 换行符与二进制判定
# 约定：仓库里一律存 LF；只有 Windows 专用脚本允许 CRLF。
# 这样 Windows 编辑、Ubuntu 部署不会出现 ^M / bad interpreter。
# =========================================================

# 默认：自动判定文本，且工作区与仓库统一 LF
* text=auto eol=lf

# ---------- 明确标记为文本（防止被误判为二进制而不做换行转换） ----------
*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.svg     text eol=lf
*.sh      text eol=lf
*.service text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf

# ---------- Windows 专用脚本：必须保持 CRLF，否则 cmd/PowerShell 解析异常 ----------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ---------- 二进制：不做换行转换，也不参与文本 diff ----------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.eot     binary
*.zip     binary
*.gz      binary
*.tgz     binary
*.tar     binary
*.whl     binary
*.exe     binary
*.dll     binary
*.so      binary
*.db      binary
*.sqlite3 binary
*.pdf     binary
