# livepush 运行期配置（复制成 .env 后按需修改）
# 只有「基础设施与密钥」放这里；业务参数在 Web UI 的「设置」页。

# 数据目录（数据库、封面缓存、日志、协议端工作目录都在里面）
LIVEPUSH_DATA_DIR=./data

# Web 监听地址。默认只监听本机；要在局域网访问改成 0.0.0.0 并自行加反代/防火墙
LIVEPUSH_HOST=127.0.0.1
LIVEPUSH_PORT=8787

LIVEPUSH_LOG_LEVEL=INFO

# 管理员口令。留空则首次启动自动生成到 data/admin-password.txt
LIVEPUSH_ADMIN_PASSWORD=

# 会话签名密钥。留空则自动生成到 data/secret.key
LIVEPUSH_SECRET_KEY=

# 自建签名服务默认监听（一般不用改）
LIVEPUSH_SIGN_HOST=127.0.0.1
LIVEPUSH_SIGN_PORT=8080

# 额外传给 sign.py 的参数（可选）。换了别的 QQ 版本、偏移自动探测失败时用：
#   LIVEPUSH_SIGN_EXTRA_ARGS="--offset 0x59660D0"
LIVEPUSH_SIGN_EXTRA_ARGS=
